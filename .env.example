# Contact form endpoint (Formspree-style: form POSTs multipart to this URL).
# Create a form at https://formspree.io and paste its endpoint, or point to your own handler.
NEXT_PUBLIC_FORM_ENDPOINT=https://formspree.io/f/your-form-id

# Public contact email shown in the footer, floating CTA and contact page.
NEXT_PUBLIC_CONTACT_EMAIL=info@dmfeng.com
