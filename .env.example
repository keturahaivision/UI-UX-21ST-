# Hugging Face token with "Make calls to Inference Providers" permission
# https://huggingface.co/settings/tokens
HF_TOKEN=hf_xxx

# Any tool-calling model served by the router (https://router.huggingface.co/v1/models).
# Good choices: Qwen/Qwen3-Coder-Next, zai-org/GLM-5.3-Flash, moonshotai/Kimi-K2.7-Code,
# openai/gpt-oss-120b, deepseek-ai/DeepSeek-V3.2. Append ":provider" to pin a provider.
HF_MODEL=Qwen/Qwen3-Coder-Next

# Render API key: https://dashboard.render.com/u/settings#api-keys
RENDER_API_KEY=rnd_xxx

# Web UI / MCP policy ceiling: read-only | safe | auto
#   read-only  -> the agent can only inspect
#   safe       -> inspect + deploy/rollback/restart/scale/env-var edits (default)
#   auto       -> everything, including suspend and delete
AGENT_MAX_MODE=safe

# Required to open the web UI when deployed. Leave empty only for local dev.
AGENT_ACCESS_TOKEN=

# Optional
# HF_BASE_URL=https://router.huggingface.co/v1
# AGENT_MAX_STEPS=30
# PORT=3000
