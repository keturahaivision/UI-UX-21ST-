{
  "mcpServers": {
    "hugging-face": {
      "command": "npx",
      "args": ["-y", "mcp-remote", "https://huggingface.co/mcp", "--header", "Authorization: Bearer ${HF_TOKEN}"],
      "env": { "HF_TOKEN": "hf_xxx" }
    },
    "comfy-cloud": {
      "command": "npx",
      "args": ["-y", "mcp-remote", "https://cloud.comfy.org/mcp"]
    },
    "render-agent": {
      "command": "node",
      "args": ["/ABSOLUTE/PATH/TO/UI-UX-21ST-/src/mcp.js"],
      "env": {
        "HF_TOKEN": "hf_xxx",
        "RENDER_API_KEY": "rnd_xxx",
        "HF_MODEL": "Qwen/Qwen3-Coder-Next",
        "AGENT_MAX_MODE": "safe"
      }
    }
  }
}
